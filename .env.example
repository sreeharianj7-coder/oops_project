# ==========================================================
# SMART HOSTEL ATTENDANCE SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your local credentials.
# (Never commit your actual .env file with real secrets)
# ==========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_hostel_attendance
DB_USERNAME=your_username
DB_PASSWORD=your_password

# College Institution Metadata
COLLEGE_NAME=Adi Shankara Institute of Science and Technology
COLLEGE_PROGRAM=B.Tech Computer Science and Engineering
COLLEGE_DEPARTMENT=Computer Science and Engineering

# Default Hostel Coordinates (Kalady Campus)
HOSTEL_NAME=ASIET Main College Hostel
HOSTEL_LATITUDE=10.16983000
HOSTEL_LONGITUDE=76.43574000
HOSTEL_ALLOWED_RADIUS=100
